*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: /GPIOS/PBL_VCT..................................*
FORM GET_DATA_/GPIOS/PBL_VCT.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM /GPIOS/PBL_CTL WHERE
(VIM_WHERETAB) .
    CLEAR /GPIOS/PBL_VCT .
/GPIOS/PBL_VCT-MANDT =
/GPIOS/PBL_CTL-MANDT .
/GPIOS/PBL_VCT-SERNR =
/GPIOS/PBL_CTL-SERNR .
/GPIOS/PBL_VCT-CCCATEGORY =
/GPIOS/PBL_CTL-CCCATEGORY .
/GPIOS/PBL_VCT-HOST =
/GPIOS/PBL_CTL-HOST .
/GPIOS/PBL_VCT-PORT =
/GPIOS/PBL_CTL-PORT .
/GPIOS/PBL_VCT-PATH =
/GPIOS/PBL_CTL-PATH .
/GPIOS/PBL_VCT-APIUS =
/GPIOS/PBL_CTL-APIUS .
/GPIOS/PBL_VCT-APIPW =
/GPIOS/PBL_CTL-APIPW .
/GPIOS/PBL_VCT-RFCDEST =
/GPIOS/PBL_CTL-RFCDEST .
    SELECT SINGLE * FROM /GPIOS/PBL_CTT WHERE
SERNR = /GPIOS/PBL_CTL-SERNR AND
SPRAS = SY-LANGU .
    IF SY-SUBRC EQ 0.
/GPIOS/PBL_VCT-DESCRIPT =
/GPIOS/PBL_CTT-DESCRIPT .
    ENDIF.
<VIM_TOTAL_STRUC> = /GPIOS/PBL_VCT.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_/GPIOS/PBL_VCT .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO /GPIOS/PBL_VCT.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_/GPIOS/PBL_VCT-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM /GPIOS/PBL_CTL WHERE
  SERNR = /GPIOS/PBL_VCT-SERNR .
    IF SY-SUBRC = 0.
    DELETE /GPIOS/PBL_CTL .
    ENDIF.
    DELETE FROM /GPIOS/PBL_CTT WHERE
    SERNR = /GPIOS/PBL_CTL-SERNR .
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM /GPIOS/PBL_CTL WHERE
  SERNR = /GPIOS/PBL_VCT-SERNR .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR /GPIOS/PBL_CTL.
    ENDIF.
/GPIOS/PBL_CTL-MANDT =
/GPIOS/PBL_VCT-MANDT .
/GPIOS/PBL_CTL-SERNR =
/GPIOS/PBL_VCT-SERNR .
/GPIOS/PBL_CTL-CCCATEGORY =
/GPIOS/PBL_VCT-CCCATEGORY .
/GPIOS/PBL_CTL-HOST =
/GPIOS/PBL_VCT-HOST .
/GPIOS/PBL_CTL-PORT =
/GPIOS/PBL_VCT-PORT .
/GPIOS/PBL_CTL-PATH =
/GPIOS/PBL_VCT-PATH .
/GPIOS/PBL_CTL-APIUS =
/GPIOS/PBL_VCT-APIUS .
/GPIOS/PBL_CTL-APIPW =
/GPIOS/PBL_VCT-APIPW .
/GPIOS/PBL_CTL-RFCDEST =
/GPIOS/PBL_VCT-RFCDEST .
    IF SY-SUBRC = 0.
    UPDATE /GPIOS/PBL_CTL .
    ELSE.
    INSERT /GPIOS/PBL_CTL .
    ENDIF.
    SELECT SINGLE FOR UPDATE * FROM /GPIOS/PBL_CTT WHERE
    SERNR = /GPIOS/PBL_CTL-SERNR AND
    SPRAS = SY-LANGU .
      IF SY-SUBRC <> 0.   "insert preprocessing: init WA
        CLEAR /GPIOS/PBL_CTT.
/GPIOS/PBL_CTT-SERNR =
/GPIOS/PBL_CTL-SERNR .
/GPIOS/PBL_CTT-SPRAS =
SY-LANGU .
      ENDIF.
/GPIOS/PBL_CTT-DESCRIPT =
/GPIOS/PBL_VCT-DESCRIPT .
    IF SY-SUBRC = 0.
    UPDATE /GPIOS/PBL_CTT .
    ELSE.
    INSERT /GPIOS/PBL_CTT .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_/GPIOS/PBL_VCT-UPD_FLAG,
STATUS_/GPIOS/PBL_VCT-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
*---------------------------------------------------------------------*
FORM READ_SINGLE_/GPIOS/PBL_VCT.
  SELECT SINGLE * FROM /GPIOS/PBL_CTL WHERE
SERNR = /GPIOS/PBL_VCT-SERNR .
/GPIOS/PBL_VCT-MANDT =
/GPIOS/PBL_CTL-MANDT .
/GPIOS/PBL_VCT-SERNR =
/GPIOS/PBL_CTL-SERNR .
/GPIOS/PBL_VCT-CCCATEGORY =
/GPIOS/PBL_CTL-CCCATEGORY .
/GPIOS/PBL_VCT-HOST =
/GPIOS/PBL_CTL-HOST .
/GPIOS/PBL_VCT-PORT =
/GPIOS/PBL_CTL-PORT .
/GPIOS/PBL_VCT-PATH =
/GPIOS/PBL_CTL-PATH .
/GPIOS/PBL_VCT-APIUS =
/GPIOS/PBL_CTL-APIUS .
/GPIOS/PBL_VCT-APIPW =
/GPIOS/PBL_CTL-APIPW .
/GPIOS/PBL_VCT-RFCDEST =
/GPIOS/PBL_CTL-RFCDEST .
    SELECT SINGLE * FROM /GPIOS/PBL_CTT WHERE
SERNR = /GPIOS/PBL_CTL-SERNR AND
SPRAS = SY-LANGU .
    IF SY-SUBRC EQ 0.
/GPIOS/PBL_VCT-DESCRIPT =
/GPIOS/PBL_CTT-DESCRIPT .
    ELSE.
      CLEAR SY-SUBRC.
      CLEAR /GPIOS/PBL_VCT-DESCRIPT .
    ENDIF.
ENDFORM.
*---------------------------------------------------------------------*
FORM CORR_MAINT_/GPIOS/PBL_VCT USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE /GPIOS/PBL_VCT-SERNR TO
/GPIOS/PBL_CTL-SERNR .
MOVE /GPIOS/PBL_VCT-MANDT TO
/GPIOS/PBL_CTL-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = '/GPIOS/PBL_CTL'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN /GPIOS/PBL_CTL TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING '/GPIOS/PBL_CTL'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

MOVE /GPIOS/PBL_CTL-SERNR TO
/GPIOS/PBL_CTT-SERNR .
MOVE SY-LANGU TO
/GPIOS/PBL_CTT-SPRAS .
MOVE /GPIOS/PBL_VCT-MANDT TO
/GPIOS/PBL_CTT-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = '/GPIOS/PBL_CTT'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN /GPIOS/PBL_CTT TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING '/GPIOS/PBL_CTT'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
